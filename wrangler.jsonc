{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "p2p-addressing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "PEER_TTL_SECONDS": "300"
  },

  "kv_namespaces": [
    { "binding": "PEER_REGISTRY", "id": "b9bdde9fc999417a84b53d45e8808298" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PEER_SIGNALING", "class_name": "PeerSignalingDO" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PeerSignalingDO"]
    }
  ],

  "routes": [
    { "pattern": "free-p2p.gwl.net.cn/*", "zone_name": "gwl.net.cn" }
  ]
}
