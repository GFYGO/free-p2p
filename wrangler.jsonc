{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p2punch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    // 节点超过这个时间没有 heartbeat 就会被判定离线并移除
    "PEER_TTL_SECONDS": "45",
    // 每个房间最多允许的在线节点数
    "MAX_PEERS_PER_ROOM": "256"
  },

  // 可选：设置后，所有 /api/* 请求都必须带匹配的 X-Room-Secret 头。
  // 用 `wrangler secret put ROOM_SECRET` 设置，不要写进这个文件。
  // "ROOM_SECRET": "change-me"

  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ]
}
